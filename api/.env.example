# Backend Environment Configuration Example
# Copy this file to .env or set environment variables in your server / virtual host.

DB_HOST=localhost
DB_NAME=medsync_db
DB_USER=root
DB_PASS=

# Session / App Environment
APP_ENV=development
APP_URL=http://localhost/medsync/api
FRONTEND_URL=http://localhost:5173

# SMTP / Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME="MedSync System"
